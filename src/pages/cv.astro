---
import { existsSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROFILE } from "../config";
import withBase from "../lib/withBase";

const resumeAvailable = existsSync(new URL("../../public/resume.pdf", import.meta.url));
---

<BaseLayout title={`简历｜${PROFILE.name}`} sideBarActiveItemID="cv">
  <div class="mb-5 flex items-center justify-between gap-4">
    <div class="text-3xl w-full font-bold">个人简历</div>
    {resumeAvailable ? (
      <a class="btn btn-outline" href={withBase(PROFILE.resumePath)} download>下载简历</a>
    ) : (
      <span class="btn btn-outline btn-disabled" aria-disabled="true" title="TODO：请将真实简历放入 public/resume.pdf">
        简历待上传
      </span>
    )}
  </div>

  <div class="mb-10">
    <p class="text-xl font-bold">{PROFILE.name}</p>
    <p>{PROFILE.identity}</p>
    <p>求职方向：{PROFILE.careerGoal}</p>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">技术栈</div>
  </div>
  <ul class="list-disc md:columns-4 columns-2 mx-6 mb-10">
    {PROFILE.techStack.map((skill) => <li>{skill}</li>)}
  </ul>

  <div class="bg-base-200 border-l-4 border-secondary w-full p-4">
    <p class="font-bold">教育、项目与实践经历待补充</p>
    <p>TODO：请补充学校、时间、项目职责、成果，以及必要的证书或获奖信息。</p>
  </div>
</BaseLayout>
