---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300 font-semibold";
import { PROFILE } from "../config";
import withBase from "../lib/withBase";
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li><a class="py-3 text-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" id="home" href={withBase('/')}>Home</a></li>
    <li><a class="py-3 text-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" id="projects" href={withBase('/projects')}>Projects</a></li>
    <li><a class="py-3 text-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" id="blog" href={withBase('/blog/')}>Blog</a></li>
    <li><a class="py-3 text-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" id="cv" href={withBase('/cv')}>CV</a></li>
    <li>
        {PROFILE.email ? (
            <a class="py-3 text-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href={`mailto:${PROFILE.email}`}>Contact</a>
        ) : (
            <span class="py-3 text-base opacity-60" aria-disabled="true" title="TODO：请先在 src/config.ts 中填写邮箱">
                Contact（邮箱待补充）
            </span>
        )}
    </li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
if (activeItemElem) {
  activeItemElem.classList.add(...activeClass.split(" "));
  activeItemElem.setAttribute("aria-current", "page");
}
</script>
