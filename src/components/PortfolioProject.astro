---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const featuresTitleId = `${project.id}-features-title`;
const completedTitleId = `${project.id}-completed-title`;
const plannedTitleId = `${project.id}-planned-title`;
---

<article class="rounded-xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
  <header class="flex flex-wrap items-center gap-3">
    <h3 class="text-xl font-bold sm:text-2xl">{project.title}</h3>
    {project.featured && <span class="badge badge-neutral">精选项目</span>}
    <span class="badge badge-secondary badge-outline">{project.status}</span>
    {project.type && <span class="badge badge-outline">{project.type}</span>}
  </header>

  <p class="mt-3 leading-relaxed text-base-content/80">{project.description}</p>

  <div class="mt-4 flex flex-wrap gap-2" aria-label={`${project.title}技术栈`}>
    {project.techStack.map((technology) => <span class="badge badge-outline">{technology}</span>)}
  </div>

  {
    !compact && project.responsibility && (
      <section class="mt-6">
        <h4 class="font-bold">个人职责</h4>
        <p class="mt-2 text-base-content/80">{project.responsibility}</p>
      </section>
    )
  }

  {
    !compact && project.coreFeatures && (
      <section class="mt-6" aria-labelledby={featuresTitleId}>
        <h4 id={featuresTitleId} class="font-bold">核心功能</h4>
        <ul class="mt-2 grid list-disc gap-x-8 gap-y-2 pl-5 text-base-content/80 md:grid-cols-2">
          {project.coreFeatures.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )
  }

  {
    !compact && (project.completedItems || project.plannedItems) && (
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {project.completedItems && (
          <section aria-labelledby={completedTitleId}>
            <h4 id={completedTitleId} class="font-bold">已完成内容</h4>
            <ul class="mt-2 list-disc space-y-2 pl-5 text-base-content/80">
              {project.completedItems.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}
        {project.plannedItems && (
          <section aria-labelledby={plannedTitleId}>
            <h4 id={plannedTitleId} class="font-bold">后续计划</h4>
            <ul class="mt-2 list-disc space-y-2 pl-5 text-base-content/80">
              {project.plannedItems.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}
      </div>
    )
  }

  {
    (project.githubUrl || project.demoUrl) && (
      <div class="mt-6 flex flex-wrap gap-3">
        {project.githubUrl && (
          <a
            class="btn btn-outline btn-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        )}
        {project.demoUrl && (
          <a
            class="btn btn-outline btn-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            在线演示
          </a>
        )}
      </div>
    )
  }
</article>
